title                   = AMBER99SB-ILDN Mitofusin 2 MD production run
; Run parameters
integrator              = md        ; leap-frog integrator
nsteps                  = 5000000   ; 2 * 5000000 = 10000 ps (10 ns)
dt                      = 0.002     ; 2 fs

; Output control
nstxout                 = 0         ; suppress bulky .trr coordinates
nstvout                 = 0         ; suppress bulky .trr velocities
nstfout                 = 0         ; suppress bulky .trr forces
nstenergy               = 5000      ; save energies every 10.0 ps
nstlog                  = 5000      ; update log file every 10.0 ps
nstxout-compressed      = 5000      ; save compressed coordinates (.xtc) every 10.0 ps
compressed-x-grps       = System    ; save the whole system

; Bond parameters
continuation            = yes       ; Restarting after NPT 
constraint_algorithm    = lincs     ; holonomic constraints 
constraints             = h-bonds   ; bonds involving H are constrained
lincs_iter              = 1         ; accuracy of LINCS
lincs_order             = 4         ; also related to accuracy

; Neighbor searching (Optimized for GPU / Verlet)
cutoff-scheme           = Verlet    ; Buffered neighbor searching
ns_type                 = grid      ; search neighboring grid cells
nstlist                 = 20        ; Increased to 20 for optimal GPU performance with Verlet scheme

; Electrostatics & vdW (AMBER convention adjustments)
coulombtype             = PME       ; Particle Mesh Ewald for long-range electrostatics
rcoulomb                = 1.0       ; Standard 1.0 nm cutoff for AMBER (consistent with NVT/NPT)
pme_order               = 4         ; cubic interpolation
fourierspacing          = 0.12      ; Finer grid spacing (0.12 nm) for accurate PME calculations

; vdW (AMBER99SB-ILDN convention specifications)
vdwtype                 = Cut-off
rvdw                    = 1.0       ; Standard 1.0 nm cutoff for AMBER (must equal rcoulomb)
DispCorr                = EnerPres  ; Long-range dispersion correction for energy and pressure
vdw-modifier            = Potential-shift ; Shifts the potential to 0 at cutoff (standard for AMBER)

; Temperature coupling (Essential group separation for production)
tcoupl                  = V-rescale             ; Stochastic Bussi thermostat
tc-grps                 = Protein Non-Protein   ; Critical separation to prevent "hot solvent" effect
tau_t                   = 0.1   0.1             ; Time constant (ps) for coupling
ref_t                   = 298   298             ; Reference temperature (K)

; Pressure coupling is on
pcoupl                  = Parrinello-Rahman     ; Standard barostat for production runs (ensures true NPT ensemble)
pcoupltype              = isotropic             ; uniform scaling of box vectors
tau_p                   = 2.0                   ; Time constant (ps), typical for Parrinello-Rahman
ref_p                   = 1.0                   ; Reference pressure (bar)
compressibility         = 4.5e-5                ; Isothermal compressibility of water (bar^-1)

; Periodic boundary conditions
pbc                     = xyz       ; 3-D PBC

; Velocity generation
gen_vel                 = no        ; Velocity generation is off (carried over from NPT)
