params {
    //hc_gvcfs   ="/cbio/users/$USER/outdir/vcfs/hc/famille_3/*.g.vcf.gz"    
    //hc_p_gvcfs ="/cbio/users/$USER/outdir/vcfs/p_hc/famille_3/*.g.vcf.gz"

    // Reference humane genome
    assembly    ="GRCh38"

    // Set the following directories
    vep_cache_dir  ="$HOME/masterproject/.vep"
    deepvariant    ="/scratch3/users/$USER/singularity_images/deepvariant_1.5.0.sif"
    tmp_dir        ="/scratch3/users/$USER/tmp"
    outdir         ="/cbio/users/$USER/outdir"
    alphamissense  ="$HOME/masterproject/.vep/Plugins/AlphaMissense_hg38.tsv.gz"
    CADD_score     ="$HOME/masterproject/.vep/Plugins/whole_genome_SNVs.tsv.gz"
    CADD_InDels    ="$HOME/masterproject/.vep/Plugins/InDels.tsv.gz"


    reference_files {
       // Reference files
       ref         = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.fasta"
       ref_index   = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.fasta.fai"
       ref_dict    = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.dict"
       ref_dir     = '/cbio/users/kmakoyi/ref/hg38'

       // SNP Resources
       dbsnp        = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.dbsnp138.vcf.gz"
       dbsnp_idx    = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.dbsnp138.vcf.gz.tbi"
       hapmap       = "/cbio/users/$USER/ref/hg38/hapmap_3.3.hg38.vcf.gz"
       hapmap_idx   = "/cbio/users/$USER/ref/hg38/hapmap_3.3.hg38.vcf.gz.tbi"
       omni         = "/cbio/users/$USER/ref/hg38/1000G_omni2.5.hg38.vcf.gz"
       omni_idx     = "/cbio/users/$USER/ref/hg38/1000G_omni2.5.hg38.vcf.gz.tbi"
       phase1       = "/cbio/users/$USER/ref/hg38/1000G_phase1.snps.high_confidence.hg38.vcf.gz"
       phase1_idx   = "/cbio/users/$USER/ref/hg38/1000G_phase1.snps.high_confidence.hg38.vcf.gz.tbi"

       // INDEL Resources (Added Mills and Known Indels)
       mills            = "/cbio/users/$USER/ref/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
       mills_idx        = "/cbio/users/$USER/ref/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
       known_indels     = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.known_indels.vcf.gz"
       known_indels_idx = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.known_indels.vcf.gz.tbi"

       // TRUTH VCF File
       TRUTH     = "/cbio/users/$USER/outdir/vcfs/recal_snp_indel_ddd-africa_473_samples.vep.vcf.gz"
       TRUTH_idx = "/cbio/users/$USER/outdir/vcfs/recal_snp_indel_ddd-africa_473_samples.vep.vcf.gz.tbi"
    }
}

// Nextflow configuration

process {
    executor = 'slurm'
    queue    = 'Main'
    clusterOptions = '--account=b16-cbio-ag' // Replace with your ilifu account
    
    // Dynamic resource allocation using task.attempt

    cpus   = { 8 * task.attempt }
    memory = { 32.GB * task.attempt }
    time   = { 240.h * task.attempt }

    // Default error handling: retry with more memory if a task fails (OOM)

    errorStrategy = { task.exitStatus in [141, 143,137,104,134,139, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    // --- Tool-Specific Configurations ---
	
    withName: 'CombineGVCFs' {
        cpus     = { 16 * task.attempt }
        memory   = { 500.GB * task.attempt }
        time     = { 24.h * task.attempt }
        scratch  = true
        queue    = 'HighMem'
    }

     withName: 'GenotypeGVCFs|VQSR_SNP|VQSR_INDEL|ApplyVQSR' {
        cpus     = { 16 * task.attempt }
        memory   = { 500.GB * task.attempt }
        time     = { 48.h * task.attempt }
        scratch  = true
        queue    = 'HighMem'
    }

    withName: 'SELECTVARIANT|SELECTVARIANTS|GATK_FILTRATION|GATK_MERGE_VCF|GATK_VCF_QC' {
        cpus     = { 8 * task.attempt }
        memory   = { 64.GB * task.attempt }
        time     = { 48.h * task.attempt }
        scratch  = true
    }

    withName: 'BCF_FILTRATION|BCF_MERGE_VCF|BCF_VCF_QC' {
        cpus     = { 8 * task.attempt }
        memory   = { 64.GB * task.attempt }
        time     = { 48.h * task.attempt }
        scratch  = true
    }

    withName: 'BCF_VEP|GATK_VEP' {
        cpus     = { 32 * task.attempt }
        memory   = { 500.GB * task.attempt }
        time     = { 48.h * task.attempt }
        scratch  = true
        queue    = 'HighMem'
    }
}

//Ensure Singularity is used as per Ilifu best practices
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "/scratch/users/$USER/singularity_cache" 
}

executor {
    queueSize = 50        // Allow 50 chromosome jobs to run at once on ilifu
}
