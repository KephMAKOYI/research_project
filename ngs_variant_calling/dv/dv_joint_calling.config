params {
    dv_gvcfs   =["/cbio/users/kmakoyi/outdir/vcfs/famille_1/ARDI0050030241_dv.g.vcf.gz","/cbio/users/kmakoyi/outdir/vcfs/famille_1/ARDI0050030242_dv.g.vcf.gz",
                 "/cbio/users/kmakoyi/outdir/vcfs/famille_1/ARDI0050030243_dv.g.vcf.gz","/cbio/users/kmakoyi/outdir/vcfs/famille_2/ARDI0051040241_dv.g.vcf.gz",
                 "/cbio/users/kmakoyi/outdir/vcfs/famille_2/ARDI0051040242_dv.g.vcf.gz","/cbio/users/kmakoyi/outdir/vcfs/famille_2/ARDI0051040243_dv.g.vcf.gz",
                 "/cbio/users/kmakoyi/outdir/vcfs/famille_3/ARDI0052110231_dv.g.vcf.gz","/cbio/users/kmakoyi/outdir/vcfs/famille_3/ARDI0052110232_dv.g.vcf.gz",
                 "/cbio/users/kmakoyi/outdir/vcfs/famille_3/ARDI0052110233_dv.g.vcf.gz"
    ]
    //dv_p_gvcfs ="/cbio/users/$USER/outdir/vcfs/p_dv/gvcfs/famille_3/*.g.vcf.gz"

    // Reference humane genome
    assembly    ="GRCh38"

    // Set the following directories
    vep_cache_dir  ="$HOME/masterproject/.vep"
    //deepvariant    ="/scratch3/users/$USER/singularity_images/deepvariant_1.6.0.sif"
    deepvariant    ="/scratch3/users/$USER/singularity_images/deepvariant_1.6.1.sif"
    tmp_dir        ="/scratch3/users/$USER/tmp"
    outdir         ="/cbio/users/$USER/outdir"
    alphamissense  ="$HOME/masterproject/.vep/Plugins/AlphaMissense_hg38.tsv.gz"
    CADD_score     ="$HOME/masterproject/.vep/Plugins/whole_genome_SNVs.tsv.gz"
    CADD_InDels    ="$HOME/masterproject/.vep/Plugins/InDels.tsv.gz"


    reference_files {
       // Reference files
       ref         = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.fasta"
       ref_index   = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.fasta.fai"
       ref_dict    = "/cbio/users/$USER/ref/hg38/Homo_sapiens_assembly38.dict"
       ref_dir     = '/cbio/users/kmakoyi/ref/hg38'
    }
}

// Nextflow configuration

process {
    executor = 'slurm'
    queue    = 'Main'
    clusterOptions = '--account=b16-cbio-ag' // Replace with your ilifu account
    
    // Dynamic resource allocation using task.attempt

    cpus   = { 2 * task.attempt }
    memory = { 16.GB * task.attempt }
    time   = { 240.h * task.attempt }

    // Default error handling: retry with more memory if a task fails (OOM)

    errorStrategy = { task.exitStatus in [141, 143,137,104,134,139, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    // --- Tool-Specific Configurations ---
	
     withName: 'GLNEXUS_MERGE' {
        container = '/scratch3/users/kmakoyi/singularity_images/glnexus_v1.4.1.sif'
        cpus     = { 16 * task.attempt }
        memory   = { 500.GB * task.attempt }
        time     = { 24.h * task.attempt }
        scratch  = true
        queue    = 'HighMem'
     }

     withName: 'SELECTVARIANTS|VARIANTFILTRATION|MERGE_VCF|VCF_QC' {
        cpus     = { 8 * task.attempt }
        memory   = { 64.GB * task.attempt }
        time     = { 48.h * task.attempt }
        scratch  = true
     }

     withName: 'VEP' {
        cpus     = { 32 * task.attempt }
        memory   = { 500.GB * task.attempt }
        time     = { 48.h * task.attempt }
        scratch  = true
        queue    = 'HighMem'
     }

}

//Ensure Singularity is used as per Ilifu best practices
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "/scratch/users/$USER/singularity_cache" 
}

executor {
    queueSize = 50        // Allow 50 chromosome jobs to run at once on ilifu
}
